# Default execution mode: 'dry-run' (never sends live transactions unless '--live-send' or MODE=live is set)
MODE=dry-run

# Solana Mainnet RPC Endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Strict fee spend ceiling in lamports (50,000,000 lamports = 0.05 SOL)
MAX_SPEND_LAMPORTS=50000000

# Keypair injection via read-only volume mount or environment variable (NEVER stored in repository)
HOST_KEYS_DIR=./keys_mount
KEYPAIR_PATH=/keys/id.json
SOLANA_PRIVATE_KEY_B58=
